<div class="dnd-cc-gm-progress">
  <p class="dnd-cc-step-intro">{{localize "DND-CC.GmProgress.Intro"}}</p>

  {{#if hasRows}}
  <div class="dnd-cc-compendium-table-scroll">
    <table class="dnd-cc-compendium-table dnd-cc-gm-progress-table">
      <thead>
        <tr>
          <th>{{localize "DND-CC.GmProgress.Column.Player"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.Character"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.Step"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.Status"}}</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td>{{this.ownerName}}</td>
          <td class="col-name">{{this.name}}</td>
          <td>{{this.currentStepLabel}}</td>
          <td>
            {{#if this.abandoned}}
            <span class="dnd-cc-gm-progress-status stuck"><i class="fa-solid fa-ghost"></i> {{localize "DND-CC.GmProgress.Abandoned"}}</span>
            {{else if this.ready}}
            <span class="dnd-cc-gm-progress-status ready"><i class="fa-solid fa-circle-check"></i> {{localize "DND-CC.GmProgress.Ready"}}</span>
            {{else}}
            <span class="dnd-cc-gm-progress-status stuck" title="{{this.missingText}}"><i class="fa-solid fa-triangle-exclamation"></i> {{this.missingText}}</span>
            {{/if}}
          </td>
          <td>
            {{#unless this.abandoned}}
            <button type="button" class="dnd-cc-gm-progress-open" data-open-draft="{{this.id}}">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "DND-CC.GmProgress.Open"}}
            </button>
            {{/unless}}
            <button type="button" class="dnd-cc-gm-progress-open dnd-cc-gm-progress-delete" data-delete-draft="{{this.id}}">
              <i class="fa-solid fa-trash"></i> {{localize "DND-CC.GmProgress.Delete"}}
            </button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="dnd-cc-empty-state">{{localize "DND-CC.GmProgress.NoDrafts"}}</p>
  {{/if}}

  <h3>{{localize "DND-CC.GmProgress.FinishedTitle"}}</h3>
  <p class="dnd-cc-step-intro">{{localize "DND-CC.GmProgress.FinishedIntro"}}</p>

  {{#if hasFinishedRows}}
  <div class="dnd-cc-compendium-table-scroll">
    <table class="dnd-cc-compendium-table dnd-cc-gm-progress-table">
      <thead>
        <tr>
          <th>{{localize "DND-CC.GmProgress.Column.Player"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.Character"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.ClassLevel"}}</th>
          <th title="{{localize 'DND-CC.GmProgress.LevelControlTitle'}}">{{localize "DND-CC.GmProgress.Column.Level"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.Species"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.Background"}}</th>
          <th>{{localize "DND-CC.GmProgress.Column.HP"}}</th>
          {{#if tracksXp}}<th>{{localize "DND-CC.GmProgress.Column.XP"}}</th>{{/if}}
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each finishedRows}}
        <tr>
          <td>{{this.ownerName}}</td>
          <td class="col-name">{{this.name}}</td>
          <td>{{this.classLevel}}</td>
          <td class="dnd-cc-level-control">
            <div class="dnd-cc-level-control-row">
              <button type="button" class="dnd-cc-level-step" data-level-adjust="{{this.id}}" data-delta="-1" {{#unless this.canLevelDown}}disabled{{/unless}} title="{{localize 'DND-CC.GmProgress.LevelDecrease'}}">-</button>
              <div class="dnd-cc-level-bar" title="{{this.totalLevel}} / 20">
                <div class="dnd-cc-level-bar-fill" style="width:{{this.levelPercent}}%"></div>
                <span class="dnd-cc-level-bar-label">{{this.totalLevel}}</span>
              </div>
              <button type="button" class="dnd-cc-level-step" data-level-adjust="{{this.id}}" data-delta="1" {{#unless this.canLevelUp}}disabled{{/unless}} title="{{localize 'DND-CC.GmProgress.LevelIncrease'}}">+</button>
            </div>
            <div class="dnd-cc-level-add-row">
              <input type="number" min="1" max="19" placeholder="{{localize 'DND-CC.GmProgress.LevelAddPlaceholder'}}" data-level-add-input="{{this.id}}" {{#unless this.canLevelUp}}disabled{{/unless}} />
              <button type="button" class="dnd-cc-gm-progress-open" data-level-add-apply="{{this.id}}" {{#unless this.canLevelUp}}disabled{{/unless}} title="{{localize 'DND-CC.GmProgress.LevelAddTitle'}}">{{localize "DND-CC.GmProgress.LevelAddApply"}}</button>
            </div>
          </td>
          <td>{{this.species}}</td>
          <td>{{this.background}}</td>
          <td>{{this.hpText}}</td>
          {{#if this.tracksXp}}
          <td>
            {{this.xpText}}
            {{#if this.xpReady}}
            <span class="dnd-cc-gm-progress-status ready"><i class="fa-solid fa-circle-check"></i> {{localize "DND-CC.GmProgress.XpReady"}}</span>
            {{/if}}
          </td>
          {{/if}}
          <td>
            <button type="button" class="dnd-cc-gm-progress-open" data-levelup-actor="{{this.id}}">
              <i class="fa-solid fa-angles-up"></i> {{localize "DND-CC.GmProgress.LevelUp"}}
            </button>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="dnd-cc-empty-state">{{localize "DND-CC.GmProgress.NoFinished"}}</p>
  {{/if}}

  <footer class="dnd-cc-compendium-sources-footer">
    <button type="button" class="dnd-cc-save-button" data-refresh>
      <i class="fa-solid fa-rotate"></i> {{localize "DND-CC.GmProgress.Refresh"}}
    </button>
  </footer>
</div>
