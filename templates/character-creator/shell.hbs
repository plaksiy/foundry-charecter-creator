<div class="dnd-cc-wizard">
  <nav class="dnd-cc-steps" aria-label="{{localize 'DND-CC.Accessibility.StepNavLabel'}}">
    <div class="dnd-cc-rail-identity">
      <button type="button" class="dnd-cc-identity-portrait" data-identity-portrait title="{{localize 'DND-CC.Identity.ChangePortrait'}}" aria-label="{{localize 'DND-CC.Identity.ChangePortrait'}}">
        <img src="{{characterImg}}" alt="" aria-hidden="true" />
      </button>
      <div class="dnd-cc-identity-fields">
        <label class="dnd-cc-identity-label" for="dnd-cc-identity-name-input">{{localize "DND-CC.Identity.Name"}}</label>
        <input type="text" id="dnd-cc-identity-name-input" class="dnd-cc-identity-name" data-identity-name value="{{characterName}}" placeholder="{{localize 'DND-CC.Identity.NamePlaceholder'}}" />
      </div>
    </div>
    <ol>
      {{#each steps}}
      <li
        class="dnd-cc-step {{#if this.active}}active{{/if}} {{#if this.done}}{{#if this.complete}}done{{else}}warn{{/if}}{{/if}}"
        data-step="{{this.id}}"
        tabindex="0"
        role="button"
        aria-current="{{#if this.active}}step{{else}}false{{/if}}"
        aria-label="{{this.label}}{{#if this.missingHint}} - {{this.missingHint}}{{/if}}"
      >
        <span class="dnd-cc-step-icon" aria-hidden="true">
          <svg viewBox="{{this.iconViewBox}}">{{{this.icon}}}</svg>
          {{#if this.done}}
          {{#if this.complete}}
          <i class="fa-solid fa-circle-check dnd-cc-step-status-badge dnd-cc-step-status-done"></i>
          {{else}}
          <i class="fa-solid fa-triangle-exclamation dnd-cc-step-status-badge dnd-cc-step-status-warn"></i>
          {{/if}}
          {{/if}}
        </span>
        <span class="dnd-cc-step-label">{{this.label}}</span>
        {{#if this.missingHint}}<i class="fa-solid fa-circle-info dnd-cc-missing-hint" aria-hidden="true" title="{{this.missingHint}}"></i>{{/if}}
      </li>
      {{/each}}
    </ol>
  </nav>

  <section class="dnd-cc-content">
    {{> (lookup . "partialPath")}}
  </section>

  <footer class="dnd-cc-footer">
    <button type="button" class="dnd-cc-back" {{#unless canGoBack}}disabled{{/unless}}>
      <i class="fa-solid fa-arrow-left"></i> {{localize "DND-CC.Back"}}
    </button>
    <div class="dnd-cc-step-counter">{{stepCounterLabel}}</div>
    <button type="button" class="dnd-cc-next" {{#unless canGoNext}}disabled{{/unless}}>
      {{nextLabel}} <i class="fa-solid fa-arrow-right"></i>
    </button>
  </footer>

  <div class="dnd-cc-overlay" data-overlay hidden>
    <div class="dnd-cc-overlay-backdrop" data-overlay-close></div>
    <div class="dnd-cc-overlay-panel" data-overlay-panel></div>
  </div>
</div>
