<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{characterName}}</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1a1a1a;
    background: #fff;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    line-height: 1.4;
  }
  h1 { margin: 0 0 0.2rem; font-size: 1.8em; }
  h2 {
    margin: 1.5rem 0 0.5rem;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid #782e22;
    font-size: 1.15em;
    page-break-after: avoid;
  }
  .headline { margin: 0 0 1rem; opacity: 0.8; }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .stat-tile {
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 0.4rem 0.6rem;
  }
  .stat-tile span { display: block; font-size: 0.75em; opacity: 0.7; }
  .stat-tile strong { font-size: 1.1em; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 0.5rem; }
  th, td { text-align: left; padding: 0.25rem 0.5rem; border-bottom: 1px solid #ddd; font-size: 0.92em; }
  .section { page-break-inside: avoid; margin-bottom: 1rem; }
  .two-col { columns: 2; column-gap: 2rem; }
  .empty { opacity: 0.6; font-style: italic; }
  .characteristics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.3rem 1rem;
    font-size: 0.9em;
    margin-bottom: 0.75rem;
  }
  .characteristics-grid span { opacity: 0.65; margin-right: 0.3rem; }
  .personality-block { margin-bottom: 0.5rem; font-size: 0.92em; }
  .personality-block strong { display: block; opacity: 0.7; font-size: 0.85em; }
  .biography { font-size: 0.92em; }
  @media print {
    body { padding: 0; }
    a { color: inherit; text-decoration: none; }
  }
</style>
</head>
<body>

  <h1>{{characterName}}</h1>
  <p class="headline">
    {{#if classSummary}}{{classSummary}}{{else}}-{{/if}}
    {{#if speciesName}} - {{speciesName}}{{/if}}
    {{#if backgroundName}} - {{backgroundName}}{{/if}}
    {{#if alignment}} - {{alignment}}{{/if}}
  </p>

  <div class="stat-grid">
    <div class="stat-tile"><span>HP</span><strong>{{hpText}}</strong></div>
    <div class="stat-tile"><span>AC</span><strong>{{ac}}</strong></div>
    <div class="stat-tile"><span>Proficiency</span><strong>{{proficiencyBonusText}}</strong></div>
    <div class="stat-tile"><span>Initiative</span><strong>{{initiativeText}}</strong></div>
    <div class="stat-tile"><span>Speed</span><strong>{{speed}} ft</strong></div>
    <div class="stat-tile"><span>Size</span><strong>{{sizeLabel}}</strong></div>
    <div class="stat-tile"><span>Passive Perception</span><strong>{{passivePerception}}</strong></div>
    {{#if lifestyleLabel}}<div class="stat-tile"><span>Lifestyle</span><strong>{{lifestyleLabel}}</strong></div>{{/if}}
  </div>

  <div class="section two-col">
    <h2 style="column-span: all;">Abilities &amp; Skills</h2>
    <table>
      <thead><tr><th>Ability</th><th>Score</th><th>Mod</th></tr></thead>
      <tbody>
        {{#each abilities}}
        <tr><td>{{this.label}}</td><td>{{this.totalText}}</td><td>{{this.modText}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    <table>
      <thead><tr><th>Skill</th><th>Prof.</th><th>Mod</th></tr></thead>
      <tbody>
        {{#each skills}}
        <tr><td>{{this.label}}</td><td>{{this.proficiencyLabel}}</td><td>{{this.totalText}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="section">
    <h2>Feats</h2>
    {{#if feats.length}}
    <ul>{{#each feats}}<li>{{this.name}}</li>{{/each}}</ul>
    {{else}}
    <p class="empty">None.</p>
    {{/if}}
  </div>

  {{#if hasSpellcasting}}
  <div class="section">
    <h2>Spells</h2>
    {{#each spellcastingGroups}}
    <p><strong>{{this.className}}</strong>
      {{#if this.cantrips}} - Cantrips {{this.cantrips.current}}/{{this.cantrips.max}}{{/if}}
      {{#if this.spells}} - Spells {{this.spells.current}}/{{this.spells.max}}{{/if}}
    </p>
    <ul>
      {{#each this.cantrips.items}}<li>{{this.name}} (cantrip)</li>{{/each}}
      {{#each this.spells.items}}<li>{{this.name}}</li>{{/each}}
    </ul>
    {{/each}}
    {{#each otherGroups}}
    <p><strong>{{this.label}}</strong></p>
    <ul>{{#each this.items}}<li>{{this.name}}</li>{{/each}}</ul>
    {{/each}}
  </div>
  {{/if}}

  <div class="section">
    <h2>Equipment &amp; Currency</h2>
    <p>{{currencyText}}</p>
    {{#if equipment.length}}
    <ul class="two-col">{{#each equipment}}<li>{{this.name}}{{this.quantityText}}</li>{{/each}}</ul>
    {{else}}
    <p class="empty">None.</p>
    {{/if}}
  </div>

  <div class="section">
    <h2>Characteristics</h2>
    <div class="characteristics-grid">
      {{#each characteristics}}
      <div><span>{{this.label}}:</span>{{this.value}}</div>
      {{/each}}
    </div>
  </div>

  <div class="section">
    <h2>Personality</h2>
    {{#each personality}}
    <div class="personality-block">
      <strong>{{this.label}}</strong>
      {{#if this.value}}{{this.value}}{{else}}<span class="empty">-</span>{{/if}}
    </div>
    {{/each}}
  </div>

  <div class="section">
    <h2>Languages</h2>
    {{#if languages.length}}
    <p>{{#each languages}}{{#unless @first}}, {{/unless}}{{this.label}}{{/each}}</p>
    {{else}}
    <p class="empty">None.</p>
    {{/if}}
  </div>

  <div class="section">
    <h2>Backstory</h2>
    <div class="biography">{{{biography}}}</div>
  </div>

  <script>
    window.addEventListener("load", () => window.print());
  </script>

</body>
</html>
