<div class="dnd-cc-step-body dnd-cc-step-background">
  <div class="dnd-cc-step-header-row">
    <div>
      <h2>{{localize "DND-CC.Steps.Background"}}</h2>
      <p class="dnd-cc-step-intro">{{localize "DND-CC.Background.Intro"}}</p>
    </div>
    <button type="button" class="dnd-cc-randomize-button" data-randomize-background>
      <i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "DND-CC.RandomizeButton"}}
    </button>
  </div>

  {{#if selectedBackgroundName}}
  <div class="dnd-cc-current-pick">
    <div class="dnd-cc-current-pick-art" style="background-color:{{selectedBackgroundColor}}"><img src="{{selectedBackgroundImg}}" alt="" /></div>
    <div class="dnd-cc-current-pick-info">
      <span class="dnd-cc-current-pick-label">{{localize "DND-CC.Steps.Background"}}</span>
      <span class="dnd-cc-current-pick-name">{{selectedBackgroundName}}</span>
    </div>
  </div>
  <div class="dnd-cc-divider"><span>{{localize "DND-CC.Background.Change"}}</span></div>
  {{/if}}

  {{#unless backgroundItems.length}}
  <p class="dnd-cc-empty-state">{{localize "DND-CC.Background.NoneAvailable"}}</p>
  {{/unless}}
  <ul class="dnd-cc-card-groups dnd-cc-card-grid">
    {{#each backgroundItemsGroups}}
    <li class="dnd-cc-card-group-label">{{this.label}}</li>
    {{#each this.entries}}
    <li class="dnd-cc-card {{#if this.selected}}selected{{/if}}" style="background-color:{{this.color}}">
      {{#if this.custom}}
      <span class="dnd-cc-card-edition dnd-cc-card-edition-custom">{{localize "DND-CC.Homebrew"}}</span>
      {{else if this.book}}
      <span class="dnd-cc-card-edition">{{this.book}}</span>
      {{else if this.ruleset}}
      <span class="dnd-cc-card-edition">{{this.ruleset}}</span>
      {{/if}}
      <div class="dnd-cc-card-icon"><img src="{{this.img}}" alt="" /></div>
      <div class="dnd-cc-card-content">
        <span class="dnd-cc-card-name">{{this.name}}</span>
        {{#if this.pills.length}}
        <div class="dnd-cc-pill-row">
          {{#each this.pills}}<span class="dnd-cc-pill" style="border-color:{{../lightColor}};color:{{../lightColor}}">{{this}}</span>{{/each}}
        </div>
        {{/if}}
        {{#if this.selected}}
        {{#if this.hasUnresolved}}
        <button type="button" class="dnd-cc-card-selected-ribbon dnd-cc-card-resolve-ribbon" data-uuid="{{this.uuid}}" title="{{localize 'DND-CC.ResolvePickTooltip'}}">
          <i class="fa-solid fa-triangle-exclamation"></i> {{localize "DND-CC.ResolvePick"}}
        </button>
        {{else}}
        <div class="dnd-cc-card-selected-ribbon"><i class="fa-solid fa-check"></i> {{localize "DND-CC.Selected"}}</div>
        {{/if}}
        {{else}}
        <div class="dnd-cc-card-actions">
          <button type="button" class="dnd-cc-card-learn-more" data-learn-more="{{this.uuid}}">
            {{localize "DND-CC.LearnMore"}}
          </button>
          <button type="button" class="dnd-cc-card-select" data-uuid="{{this.uuid}}">
            {{localize "DND-CC.Select"}} <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
        {{/if}}
      </div>
    </li>
    {{/each}}
    {{/each}}
    <li class="dnd-cc-custom-card" data-add-custom="background">
      <i class="fa-solid fa-plus"></i>
      <span>{{localize "DND-CC.AddCustom"}}</span>
    </li>
  </ul>
</div>
