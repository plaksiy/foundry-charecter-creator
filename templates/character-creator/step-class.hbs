<div class="dnd-cc-step-body dnd-cc-step-class">
  <h2>{{localize "DND-CC.Steps.Class"}}</h2>
  <p class="dnd-cc-step-intro">{{localize "DND-CC.Class.Intro"}}</p>

  {{#if partyAdvisor.missingText}}
  <p class="dnd-cc-party-advisor">
    <i class="fa-solid fa-users"></i> {{partyAdvisor.missingText}}
  </p>
  {{/if}}

  {{#if classes.length}}
  <ul class="dnd-cc-class-list">
    {{#each classes}}
    <li class="dnd-cc-class-row">
      <div class="dnd-cc-class-row-art"><img src="{{this.img}}" alt="" /></div>
      <div class="dnd-cc-class-row-info">
        <span class="dnd-cc-class-row-name">
          {{this.name}}
          {{#if this.missingHint}}<i class="fa-solid fa-circle-info dnd-cc-missing-hint" title="{{this.missingHint}}"></i>{{/if}}
          {{#if this.abilityMismatchHint}}<i class="fa-solid fa-scale-unbalanced dnd-cc-missing-hint dnd-cc-ability-mismatch-hint" title="{{this.abilityMismatchHint}}"></i>{{/if}}
        </span>
        <div class="dnd-cc-pill-row">
          {{#if this.isOriginalClass}}<span class="dnd-cc-pill" style="border-color:{{this.lightColor}};color:{{this.lightColor}}">{{localize "DND-CC.Class.OriginalClass"}}</span>{{/if}}
          {{#each this.pills}}<span class="dnd-cc-pill" style="border-color:{{../lightColor}};color:{{../lightColor}}">{{this}}</span>{{/each}}
        </div>
      </div>
      {{#if ../levelUp}}
      <span class="dnd-cc-class-row-level dnd-cc-class-row-level-static">
        {{localize "DND-CC.Class.Level"}} {{this.level}}
      </span>
      {{else}}
      <label class="dnd-cc-class-row-level">
        {{localize "DND-CC.Class.Level"}}
        <select data-class-level="{{this.id}}">
          {{#each this.levelOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.value}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
      <button type="button" class="dnd-cc-class-row-review" data-review-class="{{this.id}}" aria-label="{{localize 'DND-CC.Class.Review'}}" title="{{localize 'DND-CC.Class.Review'}}">
        <i class="fa-solid fa-pen"></i>
      </button>
      <button type="button" class="dnd-cc-class-row-remove" data-remove-class="{{this.id}}" aria-label="{{localize 'DND-CC.Class.Remove'}}" title="{{localize 'DND-CC.Class.Remove'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    </li>
    {{/each}}
  </ul>
  <p class="dnd-cc-class-total">{{localize "DND-CC.Class.TotalLevel" total=totalLevel}}</p>
  {{/if}}

  {{#if canAddClass}}
  {{#if levelUp}}
  {{#unless showAddClassGrid}}
  <p class="dnd-cc-step-intro">{{localize "DND-CC.LevelUp.ClassChoiceIntro"}}</p>
  <div class="dnd-cc-levelup-choice">
    <div class="dnd-cc-levelup-cards">
      {{#each classes}}
      {{#if this.canLevelUp}}
      <button type="button" class="dnd-cc-levelup-card" data-class-level-up="{{this.id}}">
        <div class="dnd-cc-levelup-card-icon"><img src="{{this.img}}" alt="" /></div>
        <div class="dnd-cc-levelup-card-body">
          <span class="dnd-cc-levelup-card-label">{{localize "DND-CC.LevelUp.LevelUpCardLabel"}}</span>
          <span class="dnd-cc-levelup-card-target">{{this.name}} {{this.level}} &gt; {{this.nextLevel}}</span>
          {{#if this.levelUpGains.length}}
          <ul class="dnd-cc-levelup-card-gains">
            {{#each this.levelUpGains}}<li>+ {{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
      </button>
      {{/if}}
      {{/each}}
    </div>
    <button type="button" class="dnd-cc-levelup-multiclass-card" data-show-multiclass>
      <i class="fa-solid fa-people-group" aria-hidden="true"></i>
      <span class="dnd-cc-levelup-card-label">{{localize "DND-CC.LevelUp.MulticlassButton"}}</span>
      <span class="dnd-cc-levelup-card-hint">{{localize "DND-CC.LevelUp.MulticlassPrompt"}}</span>
    </button>
  </div>
  {{/unless}}
  {{/if}}

  {{#if showAddClassGrid}}
  <div class="dnd-cc-divider"><span>{{#if classes.length}}{{localize "DND-CC.Class.AddAnother"}}{{else}}{{localize "DND-CC.Class.Choose"}}{{/if}}</span></div>
  <div class="dnd-cc-complexity-filter">
    <span class="dnd-cc-filter-label">{{localize "DND-CC.ClassExtras.ComplexityFilter"}}</span>
    <div class="dnd-cc-seg-group">
      {{#each complexityOptions}}
      <button type="button" class="{{#if this.active}}active{{/if}}" data-class-complexity="{{this.key}}">
        {{this.label}}
      </button>
      {{/each}}
    </div>
    <button type="button" class="dnd-cc-gm-progress-open" data-randomize-class>
      <i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "DND-CC.RandomizeButton"}}
    </button>
    <span class="dnd-cc-compare-tray">
      {{#unless compareMode}}
      <button type="button" class="dnd-cc-gm-progress-open" data-compare-toggle>{{localize "DND-CC.ClassExtras.Compare"}}</button>
      {{else}}
      {{#if compareCount}}<span class="dnd-cc-compare-count">{{localize "DND-CC.ClassExtras.CompareCount" count=compareCount}}</span>{{/if}}
      <button type="button" class="dnd-cc-gm-progress-open" data-compare-now {{#unless canCompare}}disabled{{/unless}}>{{localize "DND-CC.ClassExtras.CompareNow"}}</button>
      <button type="button" class="dnd-cc-gm-progress-open" data-compare-clear>{{localize "DND-CC.ClassExtras.CompareClear"}}</button>
      {{/unless}}
    </span>
  </div>
  {{#unless addableClasses.length}}
  <p class="dnd-cc-empty-state">{{localize "DND-CC.Class.NoneAvailable"}}</p>
  {{/unless}}
  <ul class="dnd-cc-card-groups dnd-cc-card-grid">
    {{#each addableClassGroups}}
    <li class="dnd-cc-card-group-label">{{this.label}}</li>
    {{#each this.entries}}
    <li class="dnd-cc-card" style="background-color:{{this.color}}">
      {{#if this.custom}}
      <span class="dnd-cc-card-edition dnd-cc-card-edition-custom">{{localize "DND-CC.Homebrew"}}</span>
      {{else if this.book}}
      <span class="dnd-cc-card-edition">{{this.book}}</span>
      {{else if this.ruleset}}
      <span class="dnd-cc-card-edition">{{this.ruleset}}</span>
      {{/if}}
      <div class="dnd-cc-card-icon"><img src="{{this.img}}" alt="" /></div>
      <div class="dnd-cc-card-content">
        <span class="dnd-cc-card-name">{{this.name}}</span>
        {{#if this.pills.length}}
        <div class="dnd-cc-pill-row">
          {{#each this.pills}}<span class="dnd-cc-pill" style="border-color:{{../lightColor}};color:{{../lightColor}}">{{this}}</span>{{/each}}
        </div>
        {{/if}}
        {{#if this.compareMode}}
        <label class="dnd-cc-card-compare-toggle">
          <input type="checkbox" data-compare-class="{{this.uuid}}" {{#if this.compareSelected}}checked{{/if}} />
          {{localize "DND-CC.ClassExtras.Compare"}}
        </label>
        {{/if}}
        <div class="dnd-cc-card-actions">
          <button type="button" class="dnd-cc-card-learn-more" data-learn-more="{{this.uuid}}">
            {{localize "DND-CC.LearnMore"}}
          </button>
          <button type="button" class="dnd-cc-card-select" data-add-class="{{this.uuid}}">
            {{localize "DND-CC.Select"}} <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>
    </li>
    {{/each}}
    {{/each}}
    <li class="dnd-cc-custom-card" data-add-custom="class">
      <i class="fa-solid fa-plus"></i>
      <span>{{localize "DND-CC.AddCustom"}}</span>
    </li>
    {{#if canAddCustomSubclass}}
    <li class="dnd-cc-custom-card" data-add-custom="subclass">
      <i class="fa-solid fa-plus"></i>
      <span>{{localize "DND-CC.AddCustomSubclass"}}</span>
    </li>
    {{/if}}
  </ul>
  {{/if}}
  {{else}}
  <p class="dnd-cc-empty-state">{{localize "DND-CC.Class.MaxLevelReached"}}</p>
  {{/if}}
</div>
