<div class="dnd-cc-step-body dnd-cc-step-skills">
  <h2>{{localize "DND-CC.Steps.Skills"}}</h2>
  <p class="dnd-cc-step-intro">{{localize "DND-CC.Skills.Intro"}}</p>

  <table class="dnd-cc-skills-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "DND-CC.Skills.Skill"}}</th>
        <th>{{localize "DND-CC.Skills.Ability"}}</th>
        <th>{{localize "DND-CC.Skills.Proficiency"}}</th>
        <th>{{localize "DND-CC.Skills.Modifier"}}</th>
        <th>{{localize "DND-CC.Skills.Passive"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each skills}}
      <tr data-ability="{{this.abilityKey}}" class="{{#if this.isProficient}}dnd-cc-skill-proficient{{/if}}">
        <td><span class="dnd-cc-prof-dot dnd-cc-prof-{{this.proficiencyTier}}"></span></td>
        <td>{{this.label}}</td>
        <td>{{this.abilityLabel}}</td>
        <td>{{this.proficiencyLabel}}</td>
        <td>{{this.totalText}}</td>
        <td>{{this.passive}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
